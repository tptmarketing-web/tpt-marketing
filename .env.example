# ---------------------------------------------------------------------------
# Environment variables for the TPT Marketing app.
# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB connection string (database that stores products, site settings, etc.)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# Password used to log into the /admin panel
ADMIN_PASSWORD=change_me

# Secret used to encrypt the admin session cookie (use a long random string, 32+ chars)
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Cloudinary credentials (image / file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Public Cloudinary cloud name (exposed to the browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Optional: only needed if you use Prisma tooling. Safe to leave pointing at the same DB.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority